{
  "name": "@clipcraft/server",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "scripts": {
    "dev": "bun run --watch src/index.ts",
    "build": "bun build src/index.ts --outdir dist",
    "start": "bun run dist/index.js",
    "lint": "biome check src",
    "typecheck": "tsc --noEmit",
    "clean": "rm -rf dist"
  },
  "dependencies": {
    "@clipcraft/db": "workspace:*",
    "@clipcraft/shared": "workspace:*",
    "drizzle-orm": "catalog:",
    "elysia": "catalog:",
    "@elysiajs/cors": "catalog:"
  },
  "devDependencies": {
    "@types/bun": "catalog:",
    "typescript": "catalog:"
  }
}
